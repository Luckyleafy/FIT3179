{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Reported reasons for doing puzzles; Ipsos / Aviva, November 2022; question denominator unspecified in release.",
  "width": "container",
  "height": 250,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 12,
  "data": {
    "url": "data/motivations.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 14,
      "domain": false,
      "tickSize": 0,
      "gridColor": "#e4e5e0",
      "labelPadding": 9
    },
    "legend": {
      "title": null,
      "labelFontSize": 12,
      "orient": "top"
    },
    "background": "#ffffff"
  },
  "transform": [
    {
      "calculate": "datum.percent + '%'",
      "as": "label"
    }
  ],
  "encoding": {
    "y": {
      "field": "reason",
      "type": "nominal",
      "sort": [
        "Enjoyment",
        "Keeping the mind active",
        "Personal challenge",
        "Relaxation"
      ],
      "title": null,
      "axis": {
        "labelLimit": 180
      }
    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "title": "Reported percentage (%)",
      "scale": {
        "domain": [
          0,
          65
        ]
      }
    },
    "tooltip": [
      {
        "field": "reason",
        "title": "Reason"
      },
      {
        "field": "percent",
        "type": "quantitative",
        "title": "Percent (%)",
        "format": ".0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#504E76",
        "size": 135,
        "opacity": 1
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "color": "#183733"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
