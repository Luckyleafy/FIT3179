{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "AppMagic puzzle subgenre IAP revenue growth. Block Puzzle has a separate, explicitly labelled scale. Source: Monetization Report 2025, p. 31.",
  "background": null,
  "data": {
    "url": "data/puzzle-growth.csv",
    "format": {
      "type": "csv",
      "parse": {
        "growth_pct": "number",
        "previous_revenue_usd": "number",
        "current_revenue_usd": "number"
      }
    }
  },
  "spacing": 24,
  "vconcat": [
    {
      "width": 610,
      "height": 42,
      "title": {
        "text": "Block Puzzle: exceptional growth",
        "subtitle": "Separate horizontal scale: 0 to 1,000%",
        "anchor": "start",
        "fontSize": 15,
        "subtitleFontSize": 11,
        "color": "#183733"
      },
      "transform": [
        {
          "filter": "datum.subgenre === 'Block Puzzle'"
        },
        {
          "calculate": "(datum.growth_pct > 0 ? '+' : '') + format(datum.growth_pct, '.2f') + '%'",
          "as": "growth_label"
        }
      ],
      "encoding": {
        "y": {
          "field": "subgenre",
          "type": "nominal",
          "sort": {
            "field": "growth_pct",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 180,
            "labelPadding": 8
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#9AA8A0",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "datum": 0,
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1000
                ]
              },
              "axis": {
                "title": null,
                "labelExpr": "datum.value + '%'",
                "gridColor": "E1E6DF", 
                "tickCount": 6
              }
            }
          }
        },
        {
          "mark": {
            "type": "bar",
            "size": 15,
            "cornerRadiusEnd": 2
          },
          "encoding": {
            "x": {
              "field": "growth_pct",
              "type": "quantitative"
            },
            "x2": {
              "datum": 0
            },
            "color": {
              "condition": {
                "test": "datum.growth_pct >= 0",
                "value": "#516b4c"
              },
              "value": "#F1642E"
            },
            "tooltip": [
              {
                "field": "subgenre",
                "title": "Subgenre"
              },
              {
                "field": "growth_label",
                "title": "Revenue change"
              },
              {
                "field": "previous_revenue_label",
                "title": "Oct 2023\u2013Sep 2024"
              },
              {
                "field": "current_revenue_label",
                "title": "Oct 2024\u2013Sep 2025"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": {
              "expr": "datum.growth_pct < 0 ? 'right' : 'left'"
            },
            "dx": {
              "expr": "datum.growth_pct < 0 ? -5 : 5"
            },
            "fontSize": 11,
            "color": "#183733"
          },
          "encoding": {
            "x": {
              "field": "growth_pct",
              "type": "quantitative"
            },
            "text": {
              "field": "growth_label"
            }
          }
        }
      ]
    },
    {
      "width": 610,
      "height": 660,
      "title": {
        "text": "Other puzzle subgenres",
        "subtitle": "Horizontal scale: \u221260 to 200%",
        "anchor": "start",
        "fontSize": 15,
        "subtitleFontSize": 11,
        "color": "#183733"
      },
      "transform": [
        {
          "filter": "datum.subgenre !== 'Block Puzzle'"
        },
        {
          "calculate": "(datum.growth_pct > 0 ? '+' : '') + format(datum.growth_pct, '.2f') + '%'",
          "as": "growth_label"
        }
      ],
      "encoding": {
        "y": {
          "field": "subgenre",
          "type": "nominal",
          "sort": {
            "field": "growth_pct",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 180,
            "labelPadding": 8
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#9AA8A0",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "datum": 0,
              "type": "quantitative",
              "scale": {
                "domain": [
                  -60,
                  200
                ]
              },
              "axis": {
                "title": "Change in in-app purchase revenue (%)",
                "labelExpr": "datum.value + '%'",
                "gridColor": "#E1E6DF",
                "tickCount": 6
              }
            }
          }
        },
        {
          "mark": {
            "type": "bar",
            "size": 15,
            "cornerRadiusEnd": 2
          },
          "encoding": {
            "x": {
              "field": "growth_pct",
              "type": "quantitative"
            },
            "x2": {
              "datum": 0
            },
            "color": {
              "condition": {
                "test": "datum.growth_pct >= 0",
                "value": "#516b4c"
              },
              "value": "#F1642E"
            },
            "tooltip": [
              {
                "field": "subgenre",
                "title": "Subgenre"
              },
              {
                "field": "growth_label",
                "title": "Revenue change"
              },
              {
                "field": "previous_revenue_label",
                "title": "Oct 2023\u2013Sep 2024"
              },
              {
                "field": "current_revenue_label",
                "title": "Oct 2024\u2013Sep 2025"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": {
              "expr": "datum.growth_pct < 0 ? 'right' : 'left'"
            },
            "dx": {
              "expr": "datum.growth_pct < 0 ? -5 : 5"
            },
            "fontSize": 11,
            "color": "#183733"
          },
          "encoding": {
            "x": {
              "field": "growth_pct",
              "type": "quantitative"
            },
            "text": {
              "field": "growth_label"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelColor": "#596963",
      "titleColor": "#183733",
      "labelFontSize": 11,
      "titlePadding": 12
    },
    "concat": {
      "spacing": 24
    }
  }
}