{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Country shares of puzzle-game downloads and in-app purchase revenue in Apptica's covered markets, Q1 2023.",

  "background": null,
  "spacing": 25,

  "hconcat": [
    {
      "width": 380,
      "height": 245,

      "title": {
        "text": "Downloads",
        "subtitle": "Share of puzzle-game downloads (%)",
        "anchor": "start",
        "fontSize": 18,
        "subtitleFontSize": 11,
        "color": "#183733",
        "subtitleColor": "#596963",
        "offset": 14
      },

      "projection": {
        "type": "equalEarth"
      },

      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
            "format": {
              "type": "topojson",
              "feature": "ne_110m_admin_0_countries"
            }
          },

          "transform": [
            {
              "filter": "toNumber(datum.id) !== 10"
            }
          ],

          "mark": {
            "type": "geoshape",
            "fill": "#E1E5DE",
            "stroke": "#FAFAF7",
            "strokeWidth": 0.6
          }
        },

        {
          "data": {
            "url": "data/puzzle-country-shares.csv",
            "format": {
              "type": "csv",
              "parse": {
                "longitude": "number",
                "latitude": "number",
                "download_share_pct": "number",
                "revenue_share_pct": "number"
              }
            }
          },

          "transform": [
            {
              "filter": "isValid(datum.download_share_pct)"
            },
            {
              "calculate": "datum.download_share_pct",
              "as": "share"
            },
            {
              "calculate": "datum.share + '%'",
              "as": "share_label"
            }
          ],

          "mark": {
            "type": "circle",
            "color": "#516b4c",
            "opacity": 0.75,
            "stroke": "#FAFAF7",
            "strokeWidth": 0.7
          },

          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },

            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },

            "size": {
              "field": "share",
              "type": "quantitative",
              "scale": {
                "type": "linear",
                "domain": [0, 50],
                "range": [0, 2000]
              },
              "legend": null
            },

            "order": {
              "field": "share",
              "sort": "descending"
            },

            "tooltip": [
              {
                "field": "country",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "share_label",
                "type": "nominal",
                "title": "Download share"
              }
            ]
          }
        }
      ]
    },

    {
      "width": 380,
      "height": 245,

      "title": {
        "text": "Spending",
        "subtitle": "Share of puzzle-game IAP revenue (%)",
        "anchor": "start",
        "fontSize": 18,
        "subtitleFontSize": 11,
        "color": "#183733",
        "subtitleColor": "#596963",
        "offset": 14
      },

      "projection": {
        "type": "equalEarth"
      },

      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
            "format": {
              "type": "topojson",
              "feature": "ne_110m_admin_0_countries"
            }
          },

          "transform": [
            {
              "filter": "toNumber(datum.id) !== 10"
            }
          ],

          "mark": {
            "type": "geoshape",
            "fill": "#E1E5DE",
            "stroke": "#FAFAF7",
            "strokeWidth": 0.6
          }
        },

        {
          "data": {
            "url": "data/puzzle-country-shares.csv",
            "format": {
              "type": "csv",
              "parse": {
                "longitude": "number",
                "latitude": "number",
                "download_share_pct": "number",
                "revenue_share_pct": "number"
              }
            }
          },

          "transform": [
            {
              "filter": "isValid(datum.revenue_share_pct)"
            },
            {
              "calculate": "datum.revenue_share_pct",
              "as": "share"
            },
            {
              "calculate": "datum.share + '%'",
              "as": "share_label"
            }
          ],

          "mark": {
            "type": "circle",
            "color": "#f0652d",
            "opacity": 0.75,
            "stroke": "#FAFAF7",
            "strokeWidth": 0.7
          },

          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },

            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },

            "size": {
              "field": "share",
              "type": "quantitative",
              "scale": {
                "type": "linear",
                "domain": [0, 50],
                "range": [0, 2000]
              },
              "legend": null
            },

            "order": {
              "field": "share",
              "sort": "descending"
            },

            "tooltip": [
              {
                "field": "country",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "share_label",
                "type": "nominal",
                "title": "IAP revenue share"
              }
            ]
          }
        }
      ]
    }
  ],

  "resolve": {
    "scale": {
      "size": "shared"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}