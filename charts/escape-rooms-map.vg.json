      "format": {
        "type": "json",
        "property": "features"
      }
    },
    {
      "name": "venues",
      "url": "data/australia-escape-room-venues.csv",
      "format": {
        "type": "csv",
        "parse": {
          "longitude": "number",
          "latitude": "number",
          "include_in_map": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.include_in_map === 1 && isValid(datum.latitude) && isValid(datum.longitude)"
        }
      ]
    },
