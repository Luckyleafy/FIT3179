{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 950,
  "height": 500,
  "background": null,

  "projection": {
    "type": "equalEarth"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },

  "transform": [
    {
      "lookup": "properties.NAME",
      "from": {
        "data": {
          "values": [
            {"Country": "United States of America", "download_share_pct": 14},
            {"Country": "India", "download_share_pct": 12},
            {"Country": "Brazil", "download_share_pct": 8},
            {"Country": "Russia", "download_share_pct": 6},
            {"Country": "Indonesia", "download_share_pct": 5},
            {"Country": "China", "download_share_pct": 4},
            {"Country": "Argentina", "download_share_pct": 4},
            {"Country": "Mexico", "download_share_pct": 4},
            {"Country": "Egypt", "download_share_pct": 4},
            {"Country": "Turkey", "download_share_pct": 3},
            {"Country": "United Kingdom", "download_share_pct": 3},
            {"Country": "France", "download_share_pct": 3},
            {"Country": "Pakistan", "download_share_pct": 3},
            {"Country": "Germany", "download_share_pct": 3},
            {"Country": "Japan", "download_share_pct": 2}
          ]
        },
        "key": "Country",
        "fields": ["download_share_pct"]
      }
    },
    {
      "calculate": "isValid(datum.download_share_pct) ? format(datum.download_share_pct, '.0f') + '%' : 'Not separately reported'",
      "as": "share_label"
    }
  ],

  "encoding": {
    "tooltip": [
      {
        "field": "properties.NAME",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "share_label",
        "type": "nominal",
        "title": "Download share"
      }
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#D9D9D9",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.download_share_pct)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "download_share_pct",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [0, 14],
            "range": ["#FEE6CE", "#D94801"]
          },
          "legend": {
            "title": "Download share (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 280,
            "values": [0, 2, 4, 6, 8, 10, 12, 14]
          }
        }
      }
    }
  ],

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}