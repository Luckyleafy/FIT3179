{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Where do puzzle-game downloads come from?",
    "subtitle": [
      "Selected countries’ download shares, Q1 2023",
      "Grey = not separately reported"
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "offset": 20
  },

  "width": 950,
  "height": 500,
  "background": "#FAFAF7",

  "projection": {
    "type": "equalEarth"
  },

  "data": {
    "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },

  "transform": [
    {
      "calculate": "toNumber(datum.id)",
      "as": "country_id"
    },
    {
      "lookup": "country_id",
      "from": {
        "data": {
          "values": [
            {"country_id": 840, "country": "United States", "download_share_pct": 14},
            {"country_id": 356, "country": "India", "download_share_pct": 12},
            {"country_id": 76, "country": "Brazil", "download_share_pct": 8},
            {"country_id": 643, "country": "Russia", "download_share_pct": 6},
            {"country_id": 360, "country": "Indonesia", "download_share_pct": 5},
            {"country_id": 156, "country": "China", "download_share_pct": 4},
            {"country_id": 32, "country": "Argentina", "download_share_pct": 4},
            {"country_id": 484, "country": "Mexico", "download_share_pct": 4},
            {"country_id": 818, "country": "Egypt", "download_share_pct": 4},
            {"country_id": 792, "country": "Turkey", "download_share_pct": 3},
            {"country_id": 826, "country": "United Kingdom", "download_share_pct": 3},
            {"country_id": 250, "country": "France", "download_share_pct": 3},
            {"country_id": 586, "country": "Pakistan", "download_share_pct": 3},
            {"country_id": 276, "country": "Germany", "download_share_pct": 3},
            {"country_id": 392, "country": "Japan", "download_share_pct": 2}
          ]
        },
        "key": "country_id",
        "fields": ["country", "download_share_pct"]
      }
    },
    {
      "calculate": "isValid(datum.country) ? datum.country : datum.properties.name",
      "as": "country_name"
    },
    {
      "calculate": "isValid(datum.download_share_pct) ? format(datum.download_share_pct, '.0f') + '%' : 'Not separately reported'",
      "as": "share_label"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#D9D9D9",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      },

      "encoding": {
        "tooltip": [
          {
            "field": "country_name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "share_label",
            "type": "nominal",
            "title": "Download share"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "isValid(datum.download_share_pct)"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      },

      "encoding": {
        "color": {
          "field": "download_share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [0, 14],
            "range": ["#FEE6CE", "#D94801"]
          },
          "legend": {
            "title": "Download share (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 280,
            "values": [0, 2, 4, 6, 8, 10, 12, 14]
          }
        },

        "tooltip": [
          {
            "field": "country_name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "share_label",
            "type": "nominal",
            "title": "Download share"
          }
        ]
      }
    }
  ],

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}