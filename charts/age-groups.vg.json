{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 355,
  "background": null,
  "data": {
    "values": [
      {
        "generation": "Gen Alpha · 8–13",
        "percent": 54
      },
      {
        "generation": "Gen Z · 14–29",
        "percent": 51
      },
      {
        "generation": "Millennials · 30–45",
        "percent": 58
      },
      {
        "generation": "Gen X · 46–61",
        "percent": 67
      },
      {
        "generation": "Boomers / Silent · 62–90",
        "percent": 74
      }
    ]
  },
  "encoding": {
    "x": {
      "field": "generation",
      "type": "ordinal",
      "sort": [
        "Gen Alpha · 8–13",
        "Gen Z · 14–29",
        "Millennials · 30–45",
        "Gen X · 46–61",
        "Boomers / Silent · 62–90"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelPadding": 10,
        "labelLimit": 120,
        "domain": false,
        "ticks": false,
        "labelExpr": "indexof(datum.label, 'Boomers') === 0 ? ['Boomers /', 'Silent'] : split(datum.label, ' · ')[0]"
      }
    },
    "y": {
      "field": "percent",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "title": "Regular puzzle players (%)",
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "labelExpr": "datum.value + '%'",
        "titlePadding": 12,
        "labelFontSize": 11,
        "gridColor": "#E3DFE7",
        "gridOpacity": 0.65,
        "domain": false,
        "ticks": false
      }
    },
    "tooltip": [
      {
        "field": "generation",
        "title": "Generation and age"
      },
      {
        "field": "percent",
        "title": "Regular puzzle play (%)"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.percent === 74",
            "value": "#F1642E"
          },
          "value": "#504E76"
        },
        "y2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.percent === 74",
            "value": "#F1642E"
          },
          "value": "#504E76"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.percent + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#393747",
        "dy": -12
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 10
}