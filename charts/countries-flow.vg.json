{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "World Sudoku Championship representation connections. Original layout using teal, black, white and coral. Counts are individual-result entries, not travel records.",
  "width": 1000,
  "height": 660,
  "padding": 10,
  "background": "#65A0A0",
  "signals": [
    {
      "name": "hoverCountry",
      "value": null,
      "on": [
        {
          "events": "@badges:mouseover, @routes:mouseover, @origins:mouseover",
          "update": "datum.country"
        },
        {
          "events": "@badges:mouseout, @routes:mouseout, @origins:mouseout",
          "update": "null"
        }
      ]
    }
  ],
