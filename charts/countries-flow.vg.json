      }
    },
    {
      "type": "symbol",
      "interactive": false,
      "from": {
        "data": "international"
      },
      "encode": {
        "update": {
          "x": {
            "field": "arrow_x"
          },
          "y": {
            "field": "arrow_y"
          },
          "shape": {
            "value": "triangle-up"
          },
          "angle": {
            "field": "arrow_angle"
          },
          "size": {
            "value": 38
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "opacity": {
            "signal": "hoverCountry === null || hoverCountry === datum.country ? 0.95 : 0.12"
          }
        }
      }
    },
    {
      "name": "badges",
