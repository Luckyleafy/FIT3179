    {
      "name": "participants",
      "url": "data/wsc-2026-country-flows.csv",
      "format": {
        "type": "csv",
        "parse": {
          "competitors": "number",
          "share_pct": "number",
          "origin_lon": "number",
          "origin_lat": "number",
          "destination_lon": "number",
          "destination_lat": "number"
        }
      }
    },
    {
      "name": "countries",
      "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_admin_0_countries"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.properties.CONTINENT !== 'Antarctica'"
        },
        {
          "type": "lookup",
          "from": "participants",
          "key": "iso3",
          "fields": [
            "properties.ADM0_A3"
          ],
          "values": [
            "competitors"
          ],
          "as": [
            "represented"
          ]
        }
      ]
    },
    {
      "name": "international",
      "source": "participants",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.iso3 !== 'IND'"
        },
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "origin_lon",
            "origin_lat"
          ],
          "as": [
            "sx",
            "sy"
          ]
        },
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "destination_lon",
            "destination_lat"
          ],
          "as": [
            "tx",
            "ty"
          ]
        },
        {
          "type": "formula",
          "expr": "(datum.sx + datum.tx)/2",
          "as": "cx"
        },
        {
          "type": "formula",
          "expr": "(datum.sy + datum.ty)/2 - abs(datum.sx - datum.tx)*0.22 - 22",
          "as": "cy"
        },
        {
          "type": "formula",
          "expr": "'M' + datum.sx + ',' + datum.sy + ' Q' + datum.cx + ',' + datum.cy + ' ' + datum.tx + ',' + datum.ty",
          "as": "route"
        },
        {
          "type": "lookup",
          "from": "badgeLayout",
          "key": "iso3",
          "fields": [
            "iso3"
          ],
          "values": [
            "badge_x",
            "badge_y"
          ],
          "as": [
            "badge_x",
            "badge_y"
          ]
        },
        {
          "type": "formula",
          "expr": "0.5625*datum.sx + 0.375*datum.cx + 0.0625*datum.tx",
          "as": "anchor_x"
        },
        {
          "type": "formula",
          "expr": "0.5625*datum.sy + 0.375*datum.cy + 0.0625*datum.ty",
          "as": "anchor_y"
        },
        {
          "type": "formula",
          "expr": "0.09*datum.sx + 0.42*datum.cx + 0.49*datum.tx",
          "as": "arrow_x"
        },
        {
          "type": "formula",
          "expr": "0.09*datum.sy + 0.42*datum.cy + 0.49*datum.ty",
          "as": "arrow_y"
        },
        {
          "type": "formula",
          "expr": "atan2(0.6*(datum.cy-datum.sy) + 1.4*(datum.ty-datum.cy), 0.6*(datum.cx-datum.sx) + 1.4*(datum.tx-datum.cx))*180/PI + 90",
          "as": "arrow_angle"
        }
      ]
    },
    {
      "name": "host",
      "values": [
        {
          "lon": 88.36304,
          "lat": 22.56263
        }
      ],
      "transform": [
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "flowWidth",
      "type": "linear",
      "domain": [
        0,
        15
      ],
      "range": [
        0.45,
        2.8
      ],
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "countries"
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "worldProjection"
        }
      ],
      "encode": {
        "update": {
          "fill": {
            "signal": "isValid(datum.represented) ? '#087F7B' : '#101919'"
          },
          "stroke": {
            "value": "#65A0A0"
          },
          "strokeWidth": {
            "value": 0.45
          }
        }
      }
    },
    {
      "name": "routes",
      "type": "path",
      "from": {
        "data": "international"
      },
      "encode": {
        "update": {
          "path": {
            "field": "route"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "signal": "hoverCountry === datum.country ? 3 : scale('flowWidth', datum.competitors)"
          },
          "opacity": {
            "signal": "hoverCountry === null || hoverCountry === datum.country ? 0.85 : 0.12"
          },
          "tooltip": {
            "signal": "{'Country': datum.country, 'Competitors': datum.competitors, 'Share of all competitors': format(datum.share_pct, '.2f') + '%', 'Event': '2026 World Sudoku Championship, Kolkata'}"
          }
        }
      }
    },
    {
      "type": "rule",
      "interactive": false,
      "from": {
        "data": "international"
      },
      "encode": {
        "update": {
          "x": {
            "field": "anchor_x"
          },
          "y": {
            "field": "anchor_y"
          },
          "x2": {
            "field": "badge_x"
          },
          "y2": {
            "field": "badge_y"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 0.65
          },
          "opacity": {
            "signal": "hoverCountry === null || hoverCountry === datum.country ? 0.7 : 0.1"
          }
        }
      }
    },
    {
      "name": "origins",
      "type": "symbol",
      "from": {
        "data": "international"
      },
      "encode": {
        "update": {
          "x": {
            "field": "sx"
          },
          "y": {
            "field": "sy"
          },
          "size": {
            "value": 30
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "stroke": {
            "value": "#087F7B"
          },
          "strokeWidth": {
            "value": 0.7
          },
          "tooltip": {
            "signal": "{'Country': datum.country, 'Competitors': datum.competitors}"
          }
