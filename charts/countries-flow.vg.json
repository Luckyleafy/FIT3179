{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Regional overview of WSC 2026 country representation, with country detail and a Europe origin inset. Author-defined display regions.",
  "width": 1000,
  "padding": 10,
  "background": null,
  "config": {
    "font": "Arial"
  },
  "signals": [
    {
      "name": "selectedRegion",
      "value": "Overview",
      "bind": {
        "input": "select",
        "name": "Explore: ",
        "options": [
          "Overview",
          "North America",
          "Europe",
          "East Asia",
          "Southeast Asia",
          "Western Asia",
          "Northern Asia",
          "Africa",
          "Oceania"
        ]
      },
      "on": [
        {
          "events": "@regionHits:click",
          "update": "datum.region"
        }
      ]
    },
    {
      "name": "hoverCountry",
      "value": null,
      "on": [
        {
          "events": "@countryHits:mouseover, @insetPoints:mouseover, @europeRows:mouseover",
          "update": "datum.country"
        },
        {
          "events": "@countryHits:mouseout, @insetPoints:mouseout, @europeRows:mouseout",
          "update": "null"
        },
        {
          "events": {
            "signal": "selectedRegion"
          },
          "update": "null"
        }
      ]
    },
    {
      "name": "hoverRegion",
      "value": null,
      "on": [
        {
          "events": "@regionHits:mouseover",
          "update": "datum.region"
        },
        {
          "events": "@regionHits:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "height",
      "update": "selectedRegion === 'Europe' ? 855 : 590"
    }
  ],
  "projections": [
    {
      "name": "worldProjection",
      "type": "equirectangular",
      "scale": 152.78874536821954,
      "translate": [
        500,
        335
      ]
    },
    {
      "name": "europeProjection",
      "type": "mercator",
      "fit": {
        "type": "MultiPoint",
        "coordinates": [
          [
            -12,
            35
          ],
          [
            34,
            63
          ]
        ]
      },
      "extent": [
        [
          10,
          10
        ],
        [
          450,
          210
        ]
      ]
    }
  ],
  "data": [
    {
      "name": "participants",
      "url": "data/wsc-2026-country-flows.csv",
      "format": {
        "type": "csv",
        "parse": {
          "competitors": "number",
          "share_pct": "number",
          "origin_lon": "number",
          "origin_lat": "number",
          "destination_lon": "number",
          "destination_lat": "number"
        }
      }
    },
    {
      "name": "regionLookup",
      "values": [
        {
          "iso3": "USA",
          "region": "North America"
        },
        {
          "iso3": "CAN",
          "region": "North America"
        },
        {
          "iso3": "FRA",
          "region": "Europe"
        },
        {
          "iso3": "DEU",
          "region": "Europe"
        },
        {
          "iso3": "HUN",
          "region": "Europe"
        },
        {
          "iso3": "GBR",
          "region": "Europe"
        },
        {
          "iso3": "EST",
          "region": "Europe"
        },
        {
          "iso3": "NLD",
          "region": "Europe"
        },
        {
          "iso3": "SVK",
          "region": "Europe"
        },
        {
          "iso3": "ITA",
          "region": "Europe"
        },
        {
          "iso3": "HRV",
          "region": "Europe"
        },
        {
          "iso3": "BGR",
          "region": "Europe"
        },
        {
          "iso3": "CZE",
          "region": "Europe"
        },
        {
          "iso3": "CHE",
          "region": "Europe"
        },
        {
          "iso3": "AUT",
          "region": "Europe"
        },
        {
          "iso3": "BLR",
          "region": "Europe"
        },
        {
          "iso3": "DNK",
          "region": "Europe"
        },
        {
          "iso3": "LUX",
          "region": "Europe"
        },
        {
          "iso3": "POL",
          "region": "Europe"
        },
        {
          "iso3": "JPN",
          "region": "East Asia"
        },
        {
          "iso3": "CHN",
          "region": "East Asia"
        },
        {
          "iso3": "KOR",
          "region": "East Asia"
        },
        {
          "iso3": "TWN",
          "region": "East Asia"
        },
        {
          "iso3": "THA",
          "region": "Southeast Asia"
        },
        {
          "iso3": "PHL",
          "region": "Southeast Asia"
        },
        {
          "iso3": "SGP",
          "region": "Southeast Asia"
        },
        {
          "iso3": "TUR",
          "region": "Western Asia"
        },
        {
          "iso3": "ARE",
          "region": "Western Asia"
        },
        {
          "iso3": "RUS",
          "region": "Northern Asia"
        },
        {
          "iso3": "MAR",
          "region": "Africa"
        },
        {
          "iso3": "AUS",
          "region": "Oceania"
        },
        {
          "iso3": "IND",
          "region": "Host country"
        }
      ]
    },
    {
      "name": "regionLayout",
      "values": [
        {
          "region": "North America",
          "lon": -100,
          "lat": 48,
          "bend": 240
        },
        {
          "region": "Europe",
          "lon": 12,
          "lat": 51,
          "bend": -95
        },
        {
          "region": "East Asia",
          "lon": 125,
          "lat": 35,
          "bend": -120
        },
        {
          "region": "Southeast Asia",
          "lon": 112,
          "lat": 8,
          "bend": 100
        },
        {
          "region": "Western Asia",
          "lon": 43,
          "lat": 30,
          "bend": -55
        },
        {
          "region": "Northern Asia",
          "lon": 90,
          "lat": 65,
          "bend": -60
        },
        {
          "region": "Africa",
          "lon": -8,
          "lat": 30,
          "bend": 85
        },
        {
          "region": "Oceania",
          "lon": 134,
          "lat": -25,
          "bend": 95
        }
      ]
    },
    {
      "name": "totals",
      "source": "participants",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "competitors"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "classified",
      "source": "participants",
      "transform": [
        {
          "type": "lookup",
          "from": "regionLookup",
          "key": "iso3",
          "fields": [
            "iso3"
          ],
          "values": [
            "region"
          ],
          "as": [
            "region"
          ]
        }
      ]
    },
    {
      "name": "countries",
      "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_admin_0_countries"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.properties.CONTINENT !== 'Antarctica'"
        },
        {
          "type": "lookup",
          "from": "participants",
          "key": "iso3",
          "fields": [
            "properties.ADM0_A3"
          ],
          "values": [
            "competitors"
          ],
          "as": [
            "represented"
          ]
        }
      ]
    },
    {
      "name": "regional",
      "source": "classified",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.iso3 !== 'IND'"
        },
        {
          "type": "aggregate",
          "groupby": [
            "region"
          ],
          "fields": [
            "competitors"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "competitors"
          ]
        },
        {
          "type": "lookup",
          "from": "regionLayout",
          "key": "region",
          "fields": [
            "region"
          ],
          "values": [
            "lon",
            "lat",
            "bend"
          ],
          "as": [
            "origin_lon",
            "origin_lat",
            "bend"
          ]
        },
        {
          "type": "formula",
          "expr": "100 * datum.competitors / data('totals')[0].total",
          "as": "share_pct"
        },
        {
          "type": "formula",
          "expr": "88.36304",
          "as": "destination_lon"
        },
        {
          "type": "formula",
          "expr": "22.56263",
          "as": "destination_lat"
        }
      ]
    },
    {
      "name": "overview",
      "source": "regional",
      "transform": [
        {
          "type": "filter",
          "expr": "selectedRegion === 'Overview'"
        }
      ]
    },
    {
      "name": "detail",
      "source": "classified",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.region === selectedRegion && datum.iso3 !== 'IND'"
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "origin_lon",
              "iso3"
            ],
            "order": [
              "ascending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "routeOrder"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.iso3 === 'USA' ? 225 : datum.iso3 === 'CAN' ? 290 : datum.region === 'Oceania' || datum.region === 'Southeast Asia' ? 65 + datum.routeOrder*12 : -35 - datum.routeOrder*9",
          "as": "bend"
        },
        {
          "type": "formula",
          "expr": "100 * datum.competitors / data('totals')[0].total",
          "as": "share_pct"
        }
      ]
    },
    {
      "name": "regionRoutes",
      "source": "overview",
      "transform": [
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "origin_lon",
            "origin_lat"
          ],
          "as": [
            "sx",
            "sy"
          ]
        },
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "destination_lon",
            "destination_lat"
          ],
          "as": [
            "tx",
            "ty"
          ]
        },
        {
          "type": "formula",
          "expr": "(datum.sx+datum.tx)/2",
          "as": "cx"
        },
        {
          "type": "formula",
          "expr": "datum.bend > 0 ? max(datum.sy,datum.ty)+datum.bend : min(datum.sy,datum.ty)+datum.bend",
          "as": "cy"
        },
        {
          "type": "formula",
          "expr": "'M'+datum.sx+','+datum.sy+' Q'+datum.cx+','+datum.cy+' '+datum.tx+','+datum.ty",
          "as": "route"
        },
        {
          "type": "formula",
          "expr": ".5184*datum.sx+.4032*datum.cx+.0784*datum.tx",
          "as": "ax"
        },
        {
          "type": "formula",
          "expr": ".5184*datum.sy+.4032*datum.cy+.0784*datum.ty",
          "as": "ay"
        },
        {
          "type": "formula",
          "expr": "atan2(1.44*(datum.cy-datum.sy)+.56*(datum.ty-datum.cy),1.44*(datum.cx-datum.sx)+.56*(datum.tx-datum.cx))*180/PI+90",
          "as": "angle"
        },
        {
          "type": "formula",
          "expr": ".25*datum.sx+.5*datum.cx+.25*datum.tx",
          "as": "badge_x"
        },
        {
          "type": "formula",
          "expr": ".25*datum.sy+.5*datum.cy+.25*datum.ty-26",
          "as": "badge_y"
        }
      ]
    },
    {
      "name": "countryRoutes",
      "source": "detail",
      "transform": [
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "origin_lon",
            "origin_lat"
          ],
          "as": [
            "sx",
            "sy"
          ]
        },
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "destination_lon",
            "destination_lat"
          ],
          "as": [
            "tx",
            "ty"
          ]
        },
        {
          "type": "formula",
          "expr": "(datum.sx+datum.tx)/2",
          "as": "cx"
        },
        {
          "type": "formula",
          "expr": "datum.bend > 0 ? max(datum.sy,datum.ty)+datum.bend : min(datum.sy,datum.ty)+datum.bend",
          "as": "cy"
        },
        {
          "type": "formula",
          "expr": "'M'+datum.sx+','+datum.sy+' Q'+datum.cx+','+datum.cy+' '+datum.tx+','+datum.ty",
          "as": "route"
        },
        {
          "type": "formula",
          "expr": ".5184*datum.sx+.4032*datum.cx+.0784*datum.tx",
          "as": "ax"
        },
        {
          "type": "formula",
          "expr": ".5184*datum.sy+.4032*datum.cy+.0784*datum.ty",
          "as": "ay"
        },
        {
          "type": "formula",
          "expr": "atan2(1.44*(datum.cy-datum.sy)+.56*(datum.ty-datum.cy),1.44*(datum.cx-datum.sx)+.56*(datum.tx-datum.cx))*180/PI+90",
          "as": "angle"
        },
        {
          "type": "formula",
          "expr": ".25*datum.sx+.5*datum.cx+.25*datum.tx",
          "as": "badge_x"
        },
        {
          "type": "formula",
          "expr": ".25*datum.sy+.5*datum.cy+.25*datum.ty-26",
          "as": "badge_y"
        }
      ]
    },
    {
      "name": "selectedCountry",
      "source": "countryRoutes",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.country === hoverCountry"
        }
      ]
    },
    {
      "name": "host",
      "values": [
        {
          "lon": 88.36304,
          "lat": 22.56263
        }
      ],
      "transform": [
        {
          "type": "geopoint",
          "projection": "worldProjection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "europe",
      "source": "classified",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.region === 'Europe'"
        },
        {
          "type": "geopoint",
          "projection": "europeProjection",
          "fields": [
            "origin_lon",
            "origin_lat"
          ],
          "as": [
            "ex",
            "ey"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "competitors",
              "country"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        }
      ]
    },
    {
      "name": "europePanel",
      "values": [
        {}
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "selectedRegion === 'Europe'"
        }
      ]
    },
    {
      "name": "widthLegend",
      "values": [
        {
          "slot": 0,
          "y": 516
        },
        {
          "slot": 1,
          "y": 537
        },
        {
          "slot": 2,
          "y": 558
        }
      ],
      "transform": [
        {
          "type": "formula",
          "expr": "selectedRegion === 'Overview' ? [5,20,40][datum.slot] : [1,5,8][datum.slot]",
          "as": "share"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "flowWidth",
      "type": "linear",
      "domain": {
        "signal": "selectedRegion === 'Overview' ? [0,50] : [0,10]"
      },
      "range": {
        "signal": "selectedRegion === 'Overview' ? [0,12] : [0,7]"
      },
      "zero": true,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "shape",
      "interactive": false,
      "encode": {
        "update": {
          "fill": {
            "signal": "isValid(datum.represented) ? '#C5D2B8' : '#E5E7DD'"
          },
          "stroke": {
            "value": "#FFFCF0"
          },
          "strokeWidth": {
            "value": 0.6
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "worldProjection"
        }
      ],
      "from": {
        "data": "countries"
      }
    },
    {
      "type": "path",
      "interactive": false,
      "encode": {
        "update": {
          "path": {
            "field": "route"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#504E76"
          },
          "strokeWidth": {
            "scale": "flowWidth",
            "field": "share_pct"
          },
          "strokeCap": {
            "value": "round"
          },
          "opacity": {
            "signal": "hoverRegion === null ? 0.72 : hoverRegion === datum.region ? 1 : 0.1"
          }
        }
      },
      "from": {
        "data": "regionRoutes"
      }
    },
    {
      "type": "symbol",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "ax"
          },
          "y": {
            "field": "ay"
          },
          "angle": {
            "field": "angle"
          },
          "shape": {
            "value": "triangle-up"
          },
          "size": {
            "signal": "pow(3+scale('flowWidth',datum.share_pct),2)"
          },
          "fill": {
            "value": "#504E76"
          },
          "opacity": {
            "signal": "hoverRegion === null ? 0.72 : hoverRegion === datum.region ? 1 : 0.1"
          }
        }
      },
      "from": {
        "data": "regionRoutes"
      }
    },
    {
      "type": "symbol",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "sx"
          },
          "y": {
            "field": "sy"
          },
          "size": {
            "value": 25
          },
          "fill": {
            "value": "#4F6B4A"
          },
          "opacity": {
            "signal": "hoverRegion === null ? 0.72 : hoverRegion === datum.region ? 1 : 0.1"
          }
        }
      },
      "from": {
        "data": "regionRoutes"
      }
    },
    {
      "type": "path",
      "interactive": true,
      "encode": {
        "update": {
          "path": {
            "field": "route"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "transparent"
          },
          "strokeWidth": {
            "value": 12
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Region':datum.region,'Competitors':datum.competitors,'Share of all competitors':format(datum.share_pct,'.2f')+'%','Action':'Click to explore countries'}"
          }
        }
      },
      "from": {
        "data": "regionRoutes"
      },
      "name": "regionHits"
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "sx"
          },
          "y": {
            "signal": "datum.sy + (datum.region === 'Europe' || datum.region === 'Northern Asia' ? -13 : 19)"
          },
          "text": {
            "field": "region"
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#393747"
          }
        }
      },
      "from": {
        "data": "regionRoutes"
      }
    },
    {
      "type": "path",
      "interactive": false,
      "encode": {
        "update": {
          "path": {
            "field": "route"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#504E76"
          },
          "strokeWidth": {
            "scale": "flowWidth",
            "field": "share_pct"
          },
          "strokeCap": {
            "value": "round"
          },
          "opacity": {
            "signal": "hoverCountry === null ? 0.72 : hoverCountry === datum.country ? 1 : 0.1"
          }
        }
      },
      "from": {
        "data": "countryRoutes"
      }
    },
    {
      "type": "symbol",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "ax"
          },
          "y": {
            "field": "ay"
          },
          "angle": {
            "field": "angle"
          },
          "shape": {
            "value": "triangle-up"
          },
          "size": {
            "signal": "pow(3+scale('flowWidth',datum.share_pct),2)"
          },
          "fill": {
            "value": "#504E76"
          },
          "opacity": {
            "signal": "hoverCountry === null ? 0.72 : hoverCountry === datum.country ? 1 : 0.1"
          }
        }
      },
      "from": {
        "data": "countryRoutes"
      }
    },
    {
      "type": "symbol",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "sx"
          },
          "y": {
            "field": "sy"
          },
          "size": {
            "value": 25
          },
          "fill": {
            "value": "#4F6B4A"
          },
          "opacity": {
            "signal": "hoverCountry === null ? 0.72 : hoverCountry === datum.country ? 1 : 0.1"
          }
        }
      },
      "from": {
        "data": "countryRoutes"
      }
    },
    {
      "type": "path",
      "interactive": true,
      "encode": {
        "update": {
          "path": {
            "field": "route"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "transparent"
          },
          "strokeWidth": {
            "value": 8
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Country':datum.country,'Competitors':datum.competitors,'Share of all competitors':format(datum.share_pct,'.2f')+'%'}"
          }
        }
      },
      "from": {
