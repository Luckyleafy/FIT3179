{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "2022 within-market mobile puzzle revenue shares for selected categories. Unreported values are missing, not zero. Sensor Tower page 13.",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 12,
  "data": {
    "url": "data/market-shares.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 14,
      "domain": false,
      "tickSize": 0,
      "gridColor": "#e4e5e0",
      "labelPadding": 9
    },
    "legend": {
      "title": null,
      "labelFontSize": 12,
      "orient": "top"
    },
    "background": "#ffffff"
  },
  "transform": [
    {
      "calculate": "isValid(datum.percent) ? datum.percent + '%' : '\u2014'",
      "as": "label"
    },
    {
      "calculate": "isValid(datum.percent) ? datum.percent + '%' : 'Not separately reported'",
      "as": "reported"
    }
  ],
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "sort": [
        "Swap",
        "Blast",
        "Merge"
      ],
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "market",
      "type": "nominal",
      "sort": [
        "United States",
        "Japan",
        "China",
        "Europe"
      ],
      "title": null
    },
    "tooltip": [
      {
        "field": "market",
        "title": "Market"
      },
      {
        "field": "category",
        "title": "Category"
      },
      {
        "field": "reported",
        "title": "Revenue share"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "color": "#eceeea",
        "stroke": "white",
        "strokeWidth": 3
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.percent)"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "field": "percent",
          "type": "quantitative",
          "title": "Revenue share (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#eef7f1",
              "#08615c"
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 180
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "isValid(datum.percent) && datum.percent >= 55",
            "value": "white"
          },
          "value": "#24443e"
        }
      }
    }
  ]
}
